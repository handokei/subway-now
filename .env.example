# 공공데이터포털 API 키 (https://www.data.go.kr)
# 서울교통공사 1~8호선 역사 좌표 및 실시간 도착 정보 API
EXPO_PUBLIC_DATA_API_KEY=

# 서울 열린데이터광장 API 키 (https://data.seoul.go.kr)
# 서울시 지하철 실시간 도착정보 API
EXPO_PUBLIC_SEOUL_DATA_API_KEY=

# 카카오 Developers API 키 (https://developers.kakao.com)
# 앱 등록 후 JavaScript 키 발급
EXPO_PUBLIC_KAKAO_MAP_KEY=

# Supabase (https://supabase.com)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth Client ID (https://console.cloud.google.com)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Kakao OAuth Client ID (https://developers.kakao.com)
EXPO_PUBLIC_KAKAO_CLIENT_ID=
